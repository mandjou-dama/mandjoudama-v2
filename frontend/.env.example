NEXT_PUBLIC_SUPABASE_URL="" # Required - The URL of your Supabase project
NEXT_PUBLIC_SUPABASE_ANON_KEY="" # Required - The anon (public) key of your Supabase project
SUPABASE_SERVICE_ROLE_KEY="" # Server only - lets /api/now-playing write the now_playing row and upload covers. Never prefix with NEXT_PUBLIC_
NOW_PLAYING_TOKEN="" # Server only - shared secret the "Get Current Song" shortcut sends as "Authorization: Bearer <token>"
KEYSTATIC_GITHUB_CLIENT_ID="" # Production admin (/keystatic) - from the GitHub App that Keystatic creates; all four below come from its setup
KEYSTATIC_GITHUB_CLIENT_SECRET="" # Server only
KEYSTATIC_SECRET="" # Server only - at least 32 characters
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG="" # The GitHub App's slug
NEXT_PUBLIC_KEYSTATIC_STORAGE="" # Local only - set to "github" to run the admin in GitHub mode on localhost (one-time GitHub App setup)
